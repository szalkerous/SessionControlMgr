<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SessionControlMgr"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:cnv="clr-namespace:System.ComponentModel;assembly=System.ComponentModel.TypeConverter"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray" x:Class="SessionControlMgr.MainWindow"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        Title="Session Lock Monitor" Height="351" Width="600" ResizeMode="CanMinimize" Icon="/seslckmon.png">

    <Window.Resources>
        <local:SettingsData x:Key="cfg" x:Name="cfg" />
        <ObjectDataProvider MethodName="GetValues"
        ObjectType="{x:Type sys:Enum}"
        x:Key="enumVK">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:VK" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF2E2E2E"/>
            <GradientStop Color="#FF1A1A1A" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="16,16,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="171*"/>
            <ColumnDefinition Width="113*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48px"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" VerticalAlignment="Top" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40px"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40px"/>
                <ColumnDefinition Width="60px"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>
            <ToggleButton IsChecked="False" Style="{DynamicResource MaterialDesignSwitchToggleButton}" Height="20" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="toggleEnabled" x:Name="toggleEnabled" Checked="toggleEnabled_Checked" Unchecked="toggleEnabled_Unchecked">
                <ToggleButton.Resources>

                    <!-- Checked track color: There will be an opacity of 0.26 applied to it -->
                    <!-- Unchecked track color: Hard coded to be black with 0.26 opacity -->
                    <!-- Checked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="Red" />
                    <!-- Unchecked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="Green" />

                    <!-- Setting this will also affect the color of the ripple when the thumb is clicked -->
                    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="Cyan" />
                </ToggleButton.Resources>
            </ToggleButton>
            <TextBlock HorizontalAlignment="Left" Height="20" Text="Enabled" VerticalAlignment="Top" Width="auto" FontSize="14" Grid.Row="0" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <ToggleButton IsChecked="False" Style="{DynamicResource MaterialDesignSwitchToggleButton}" Height="20" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="toggleAutoStart" x:Name="toggleAutoStart" Checked="toggleAutoStart_Checked" Unchecked="toggleAutoStart_Unchecked">
                <ToggleButton.Resources>

                    <!-- Checked track color: There will be an opacity of 0.26 applied to it -->
                    <!-- Unchecked track color: Hard coded to be black with 0.26 opacity -->
                    <!-- Checked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="Red" />
                    <!-- Unchecked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="Green" />

                    <!-- Setting this will also affect the color of the ripple when the thumb is clicked -->
                    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="Cyan" />
                </ToggleButton.Resources>
            </ToggleButton>
            <TextBlock HorizontalAlignment="Right" Height="20" Text="AutoStart" VerticalAlignment="Top" Width="auto" FontSize="14" Grid.Row="0" Grid.Column="3" Margin="0,0,0,0">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <ToggleButton IsChecked="False" Style="{DynamicResource MaterialDesignSwitchToggleButton}" Height="20" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Tag="toggleStartMinimized" x:Name="toggleStartMinimized" Checked="toggleStartMinimized_Checked" Unchecked="toggleStartMinimized_Unchecked">
                <ToggleButton.Resources>

                    <!-- Checked track color: There will be an opacity of 0.26 applied to it -->
                    <!-- Unchecked track color: Hard coded to be black with 0.26 opacity -->
                    <!-- Checked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidForegroundBrush" Color="Red" />
                    <!-- Unchecked thumb foreground -->
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="Green" />

                    <!-- Setting this will also affect the color of the ripple when the thumb is clicked -->
                    <SolidColorBrush x:Key="PrimaryHueLightBrush" Color="Cyan" />
                </ToggleButton.Resources>
            </ToggleButton>
            <TextBlock HorizontalAlignment="Left" Height="20" Text="Minimize On Startup" VerticalAlignment="Top" Width="auto" FontSize="14" Grid.Row="1" Grid.Column="1" Margin="0,0,0,0">
                <TextBlock.Foreground>
                    <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}"/>
                </TextBlock.Foreground>
            </TextBlock>
        </Grid>

        <Border Tag="cardSettings" x:Name="cardSettings" Grid.Row="1" Height="auto" Width="auto" BorderThickness="1,1,1,1" Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}" Margin="0,0,0,0" VerticalAlignment="Top" IsManipulationEnabled="True" Grid.ColumnSpan="2">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FFFAFAFA" Opacity="0.7"/>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="cardSettings_Scale"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="5,5,5,15" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>




                <!-- Blocking Triggers -->
                <Grid Grid.Row="0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48px"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32px"/>
                        <RowDefinition Height="22px"/>
                        <RowDefinition Height="22px"/>
                        <RowDefinition Height="22px"/>
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left" Height="20" Text="Block during these conditions:" VerticalAlignment="Center" Width="auto" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0"/>
                    <!-- Option 1 -->
                    <RadioButton Tag="optionAlways" x:Name="optionAlways" Content="Always" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0" IsChecked="True" />
                    <!-- Option 2 -->
                    <RadioButton Tag="optionDuration" x:Name="optionDuration" Content="For this duration:" HorizontalAlignment="Left" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <TextBox Tag="textboxHours" x:Name="textboxHours" Style="{DynamicResource MaterialDesignTextBox}" HorizontalAlignment="Left" Width="40" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="150,0,0,0" InputScope="Number" MaxLength="2" PreviewTextInput="MaskNumericInput" DataObject.Pasting="MaskNumericPaste" TextChanged="textboxHours_TextChanged" FontSize="14" TextAlignment="Center">
                        <materialDesign:TextFieldAssist.CharacterCounterVisibility>Hidden</materialDesign:TextFieldAssist.CharacterCounterVisibility>
                        <materialDesign:ValidationAssist.UsePopup>false</materialDesign:ValidationAssist.UsePopup>
                        <Binding Path="Hours" Source="{StaticResource cfg}"
             UpdateSourceTrigger="PropertyChanged" >
                            <Binding.ValidationRules>
                                <local:NumericValidationRule Min="0" Max="24"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox>
                    <TextBlock HorizontalAlignment="Left" Height="20" Text="hour(s)," VerticalAlignment="Center" Width="auto" FontSize="14" Grid.Row="2" Grid.Column="1" Margin="195,5,0,0"/>
                    <TextBox Tag="textboxMinutes" x:Name="textboxMinutes" Style="{DynamicResource MaterialDesignTextBox}" HorizontalAlignment="Left" Width="40" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="250,0,0,0" MaxLength="2" PreviewTextInput="MaskMinutesInput" DataObject.Pasting="MaskNumericPaste" FontSize="14" TextAlignment="Center">
                        <materialDesign:TextFieldAssist.CharacterCounterVisibility>Hidden</materialDesign:TextFieldAssist.CharacterCounterVisibility>
                        <materialDesign:ValidationAssist.UsePopup>false</materialDesign:ValidationAssist.UsePopup>
                        <Binding Path="Minutes" Source="{StaticResource cfg}"
             UpdateSourceTrigger="PropertyChanged" >
                            <Binding.ValidationRules>
                                <local:NumericValidationRule Min="0" Max="59"/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox>
                    <TextBlock HorizontalAlignment="Left" Height="20" Text="minute(s)" VerticalAlignment="Center" Width="auto" FontSize="14" Grid.Row="2" Grid.Column="1" Margin="295,5,0,0"/>
                    <!-- Option 3 -->
                    <RadioButton Tag="optionRange" x:Name="optionRange" Content="Between these hours:" HorizontalAlignment="Left" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <materialDesign:TimePicker Tag="pickerFrom" x:Name="pickerFrom" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="150,0,0,0" FontSize="14"/>
                    <TextBlock HorizontalAlignment="Left" Height="20" Text="to" VerticalAlignment="Center" Width="auto" FontSize="14" Grid.Row="3" Grid.Column="1" Margin="240,5,0,0"/>
                    <materialDesign:TimePicker Tag="pickerTo" x:Name="pickerTo"  Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="262,0,0,0" FontSize="14"/>
                </Grid>

                <!-- Blocking Actions -->
                <Grid Grid.Row="1" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48px"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32px"/>
                        <RowDefinition Height="22px"/>
                        <RowDefinition Height="22px"/>
                        <RowDefinition Height="22px"/>
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left" Height="20" Text="Use these methods:" VerticalAlignment="Center" Width="auto" FontSize="14" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0"/>
                    <ComboBox x:Name="comboKeyCode" Tag="comboKeyCode" Style="{DynamicResource MaterialDesignComboBox}" Grid.Column="2" Grid.Row="2" ItemsSource="{Binding Source={local:Enumeration {x:Type local:VK}}}" DisplayMemberPath="Description"  HorizontalAlignment="Left" Margin="0,0,0,0" VerticalAlignment="Top" IsEditable="True" FontSize="14" FontWeight="Bold" IsSynchronizedWithCurrentItem="True" SelectedIndex="0" Text="175">
                        <!--<ComboBox.Text>
                    <Binding Path="KeyCode" Source="{StaticResource cfg}"
             UpdateSourceTrigger="PropertyChanged" >
                        <Binding.ValidationRules>
                            <local:NumericValidationRule Min="0" Max="255"/>
                        </Binding.ValidationRules>
                    </Binding>
                </ComboBox.Text>-->
                    </ComboBox>
                    <CheckBox Tag="checkboxSTES" x:Name="checkboxSTES" Grid.Column="1" Grid.ColumnSpan="2" Content="Set thread execution state to reset display and system idle timers" HorizontalAlignment="Left" Margin="0,0,10,0" Grid.Row="1" VerticalAlignment="Center" ToolTip="The system automatically detects activities such as local keyboard or mouse input, server activity, and changing window focus. This calls SetThreadExecutionState with ES_CONTINUOUS, ES_SYSTEM_REQUIRED, and ES_DISPLAY_REQUIRED flags. This function does not stop the screen saver from executing."/>
                    <CheckBox Tag="checkboxKeycode" x:Name="checkboxKeycode" Grid.Column="1" Content="Simulate key press with virtual keycode:" HorizontalAlignment="Left" Margin="0,0,10,0" Grid.Row="2" VerticalAlignment="Center"/>
                    <CheckBox Tag="checkboxMouse" x:Name="checkboxMouse" Grid.Column="1" Grid.ColumnSpan="2" Content="Wiggle the mouse" HorizontalAlignment="Left" Margin="0,0,10,0" Grid.Row="3" VerticalAlignment="Center" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Blocking Status -->
        <Border Tag="cardStatus" x:Name="cardStatus" Grid.Row="1" Height="24" BorderThickness="1,1,1,1" Style="{DynamicResource MaterialDesignToolBarMainPanelBorderStyle}" VerticalAlignment="Bottom" Margin="0,0,0,0" Grid.ColumnSpan="2">
            <Border.BorderBrush>
                <SolidColorBrush Color="#FFFAFAFA" Opacity="0.7"/>
            </Border.BorderBrush>
            <Border.LayoutTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform x:Name="cardStatus_Trans"/>
                </TransformGroup>
            </Border.LayoutTransform>
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlLightColorKey}}"/>
                    <GradientStop Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>


            <Grid Height="Auto">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60px"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70px"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="50px"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <TextBlock  Tag="textStatusBanner" x:Name="textStatusBanner" Text="Session Locking Is Disabled" HorizontalAlignment="Center" VerticalAlignment="Top" Width="Auto" Grid.Row="0" Grid.ColumnSpan="6" FontSize="36" FontWeight="Bold" TextAlignment="Center" Visibility="Collapsed" >
                    <TextBlock.Effect>
                        <DropShadowEffect Opacity="0.7" ShadowDepth="3"/>
                    </TextBlock.Effect>
                    <TextBlock.Foreground>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="LightGray"  Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>

                <TextBlock HorizontalAlignment="Left" Height="20" Text="Status:" VerticalAlignment="Bottom" FontSize="14"  Grid.Row="1" Grid.Column="0" Margin="5,0,0,0"/>
                <TextBlock HorizontalAlignment="Left" Height="20" MinWidth="100" Text="" VerticalAlignment="Bottom" FontSize="14" Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" FontWeight="Bold" Tag="textStatus" x:Name="textStatus"/>
                <TextBlock HorizontalAlignment="Left" Height="20" Text="Run Time:" VerticalAlignment="Bottom" FontSize="14" Grid.Row="1" Grid.Column="2" Margin="0,0,0,0"/>
                <TextBlock HorizontalAlignment="Left" Height="20" MinWidth="60" Text="" VerticalAlignment="Bottom" FontSize="14" Grid.Row="1" Grid.Column="3" Margin="0,0,10,0" FontWeight="Bold" Tag="textElapsed" x:Name="textElapsed"/>
                <TextBlock HorizontalAlignment="Left" Height="20" Text="Pokes:" VerticalAlignment="Bottom" FontSize="14" Grid.Column="4" Grid.Row="1" Margin="0,0,0,0"/>
                <TextBlock HorizontalAlignment="Left" Height="20" MinWidth="60" Text="" VerticalAlignment="Bottom" FontSize="14" Grid.Row="1" Grid.Column="5" Margin="0,0,0,0" FontWeight="Bold" Tag="textPokes" x:Name="textPokes"/>
            </Grid>
        </Border>


        <tray:NotifyIcon Grid.Column="1" HorizontalAlignment="Left" Height="100" Margin="417,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="100" MenuOnRightClick="False" TooltipText="Session Lock Monitor" Icon="pack://application:,,,/seslckmon.ico" IsManipulationEnabled="True" LeftClick="NotifyIcon_LeftClick">
        </tray:NotifyIcon>


    </Grid>

</Window>
